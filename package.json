{
  "name": "timescaledb-sdk",
  "version": "0.1.0",
  "description": "SDK for interacting with TimescaleDB",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && tsc --project tsconfig.build.json",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezrasperodev/timescaledb-sdk"
  },
  "keywords": [
    "timescaledb",
    "timescale",
    "postgres",
    "time-series",
    "sdk"
  ]
}
